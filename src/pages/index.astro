---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Ethan Nguyen | Product Operations">
  <div class="grid gap-10 lg:grid-cols-[340px_1fr]">
    <!-- Left Column -->
    <aside class="lg:sticky lg:top-10 lg:h-[calc(100vh-5rem)]">
      <div class="space-y-8">
        <!-- Identity -->
        <section>
          <h1 class="text-3xl font-semibold tracking-tight">Ethan Nguyen</h1>
          <p class="mt-1 text-lg text-slate-700">
            Product Operations | Fintech & Workflow Systems
          </p>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Automation Process Integration • Escalations • Feedback Loops
          </p>
        </section>

        <!-- Contact -->
        <section class="space-y-2">
          <h2
            class="text-sm font-semibold uppercase tracking-wide text-slate-500"
          >
            Contact
          </h2>
          <ul class="space-y-1 text-sm">
            <li>
              <a
                class="underline decoration-slate-300 hover:decoration-slate-600"
                href="mailto:nguyen.ethan@outlook.com"
              >
                Nguyen.Ethan@outlook.com
              </a>
            </li>
            <li>
              <a
                class="underline decoration-slate-300 hover:decoration-slate-600"
                href="https://www.linkedin.com/in/luckynguyen/"
                target="_blank"
                rel="noreferrer"
              >
                LinkedIn
              </a>
            </li>
            <li>
              <a
                class="underline decoration-slate-300 hover:decoration-slate-600"
                href="https://github.com/lucky15987"
                target="_blank"
                rel="noreferrer"
              >
                GitHub
              </a>
            </li>
            <li class="text-slate-600">Atlanta, GA</li>
          </ul>
        </section>

        <!-- Skills -->
        <section class="space-y-2">
          <h2
            class="text-sm font-semibold uppercase tracking-wide text-slate-500"
          >
            Core Skills
          </h2>
          <ul class="space-y-1 text-sm text-slate-700">
            <li>Process Design</li>
            <li>Cross-Team Enablement</li>
            <li>Tooling & Automation</li>
            <li>Metrics & Data Analytics</li>
          </ul>
        </section>

        <!-- Tools -->
        <section class="space-y-2">
          <h2
            class="text-sm font-semibold uppercase tracking-wide text-slate-500"
          >
            Tools
          </h2>
          <div class="flex flex-wrap gap-2">
            {
              [
                "PowerBI",
                "Notion",
                "Linear",
                "Slack",
                "SQL",
                "Salesforce",
                "DataDog",
                "Incident.io",
              ].map((tool) => (
                <span class="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-700">
                  {tool}
                </span>
              ))
            }
          </div>
        </section>
      </div>
    </aside>

    <!-- Right Column -->
    <section class="space-y-10">
      <!-- About -->
      <section>
        <h2 class="text-xl font-semibold">About</h2>

        <p class="mt-4 max-w-2xl leading-relaxed text-slate-700">
          I build operating systems for product teams. In fintech environments,
          I improve SLA performance, standardize workflows, and establish
          feedback loops across Support, Engineering, and Product to reduce
          friction and accelerate execution.
        </p>

        <div class="mt-8 grid gap-8 sm:grid-cols-3">
          <div class="min-w-0">
            <p
              class="text-xs font-semibold uppercase tracking-wide text-slate-500"
            >
              Workflow Systems
            </p>
            <p class="mt-2 text-sm leading-snug text-slate-700">
              Issue Intake • Escalation • SLA Optimization
            </p>
          </div>

          <div class="min-w-0">
            <p
              class="text-xs font-semibold uppercase tracking-wide text-slate-500"
            >
              Cross-Team Alignment
            </p>
            <p class="mt-2 text-sm leading-snug text-slate-700">
              Support ↔ Engineering ↔ Product
            </p>
          </div>

          <div class="min-w-0">
            <p
              class="text-xs font-semibold uppercase tracking-wide text-slate-500"
            >
              Tooling &amp; Insights
            </p>
            <p class="mt-2 text-sm leading-snug text-slate-700">
              FreshService • Dashboards • AI Integrations
            </p>
          </div>
        </div>
      </section>

      <!-- Experience -->
      <section class="space-y-6">
        <h2 class="text-xl font-semibold">Experience</h2>

        <article class="rounded-2xl border border-slate-200 p-6">
          <header
            class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"
          >
            <h3 class="text-base font-semibold">
              Platform Technical Advisor — Liberis
            </h3>
            <p class="text-sm text-slate-600">Jun 2024 – Present</p>
          </header>
          <p class="mt-1 text-sm text-slate-700">Embedded Finance / Fintech</p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-700">
            <li>
              Designed and implemented an automated escalation workflow
              connecting FreshService, Slack, and Linear, reducing manual
              escalation effort and improving engineering intake consistency
            </li>

            <li>
              Led incident response for high-impact platform issues, reducing
              time-to-resolution by improving coordination across engineering
              and operations
            </li>

            <li>
              Built operational dashboards across FreshService Analytics, Power
              BI, Looker, and Datadog, increasing visibility into support
              performance and escalation trends
            </li>

            <li>
              Standardized partner issue intake and escalation processes,
              reducing cross-team friction and improving triage consistency
            </li>

            <li>
              Prototyped AI-assisted workflows (Claude, ChatGPT) to enhance
              ticket triage, reducing repetitive analysis and improving
              categorization accuracy
            </li>
          </ul>
        </article>

        <article class="rounded-2xl border border-slate-200 p-6">
          <header
            class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"
          >
            <h3 class="text-base font-semibold">
              Front-End Developer — Popcapacity
            </h3>
            <p class="text-sm text-slate-600">Aug 2022 – Jun 2024</p>
          </header>
          <p class="mt-1 text-sm text-slate-700">Logistics / Supply Chain</p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-700">
            <li>
              Translated user needs and product ideas into structured user
              stories and implementation-ready requirements, reducing ambiguity
              between product and engineering during development cycles
            </li>

            <li>
              Identified usability and workflow friction points through testing
              and analysis, improving overall product experience and reducing
              user confusion
            </li>

            <li>
              Performed structured QA testing and created reproducible defect
              reports, reducing back-and-forth during releases and improving
              release reliability
            </li>

            <li>
              Collaborated with product managers and designers to validate
              features and UX decisions prior to release, increasing confidence
              in shipped changes
            </li>

            <li>
              Improved front-end consistency by refining component behavior and
              interaction patterns across the platform, reducing inconsistencies
              in user experience
            </li>
          </ul>
        </article>

        <article class="rounded-2xl border border-slate-200 p-6">
          <header
            class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"
          >
            <h3 class="text-base font-semibold">
              Operations Manager — International Real Estate Dream LLC
            </h3>
            <p class="text-sm text-slate-600">Aug 2021 – Aug 2022</p>
          </header>
          <p class="mt-1 text-sm text-slate-700">
            Real Estate / Property Management
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-700">
            <li>
              Led brokerage operations, coordinating workflows across agents and
              stakeholders.
            </li>
            <li>
              Implemented process improvements to increase operational
              efficiency and KPI visibility.
            </li>
            <li>
              Analyzed housing and rental market data to support pricing and
              strategy decisions.
            </li>
            <li>
              Built operational reports and presentations to communicate
              performance trends.
            </li>
          </ul>
        </article>

        <article class="rounded-2xl border border-slate-200 p-6">
          <header
            class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"
          >
            <h3 class="text-base font-semibold">
              Customer Success Manager — Microsoft
            </h3>
            <p class="text-sm text-slate-600">Apr 2020 – Aug 2021</p>
          </header>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-700">
            <li>
              Led implementation planning for SMB and enterprise clients
              adopting Microsoft cloud solutions.
            </li>
            <li>
              Identified recurring integration challenges and developed
              repeatable enablement approaches.
            </li>
            <li>
              Designed training frameworks for organizations transitioning to
              Microsoft 365.
            </li>
            <li>
              Created reporting templates to surface adoption trends and renewal
              risk signals.
            </li>
          </ul>
        </article>
      </section>

      <!-- Operational Systems -->
      <section class="space-y-4">
        <h2 class="text-xl font-semibold">Operational Systems</h2>

        <div class="grid gap-4 sm:grid-cols-2">
          <a
            class="group rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-sm"
            href="/projects/escalation-automation"
          >
            <h3 class="font-semibold">
              End-to-End Escalation Automation System
            </h3>

            <p class="mt-2 text-sm text-slate-700">
              Automated support-to-engineering escalation workflow across
              FreshService, Slack, Make, and Linear.
            </p>

            <p class="mt-3 text-sm text-slate-600">
              Designed a structured pipeline that converted manual handoffs into
              engineering-ready work items with improved visibility and
              traceability.
            </p>

            <ul class="mt-3 text-xs text-slate-600 space-y-1">
              <li>• Reduced manual escalation overhead</li>
              <li>• Standardized engineering-to-work data requirements</li>
              <li>• Improved cross-team visibility</li>
            </ul>

            <p class="mt-4 text-xs text-slate-500 group-hover:text-slate-700">
              View case study →
            </p>
          </a>

          <a
            class="group rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-sm"
            href="/projects/ai-triage"
          >
            <h3 class="font-semibold">AI-Powered Ticket Triage System</h3>

            <p class="mt-2 text-sm text-slate-700">
              Prototype system using AI to classify, prioritize, and route
              support tickets.
            </p>

            <p class="mt-3 text-sm text-slate-600">
              Designed an AI-assisted workflow to reduce triage time and improve
              routing consistency across support and engineering.
            </p>

            <ul class="mt-3 text-xs text-slate-600 space-y-1">
              <li>• Automated ticket categorization</li>
              <li>• Suggested priority scoring</li>
              <li>• Improved triage consistency</li>
            </ul>

            <p class="mt-4 text-xs text-slate-500 group-hover:text-slate-700">
              View case study →
            </p>
          </a>
        </div>
      </section>

      <!-- Education -->
      <section class="space-y-4">
        <h2 class="text-xl font-semibold">Education</h2>

        <div class="space-y-4">
          <div>
            <p class="font-semibold text-slate-900">
              Bachelor of Science in Computer Science
            </p>
            <p class="text-sm text-slate-600">
              Kennesaw State University · 2016 – 2020
            </p>
          </div>

          <div>
            <p class="font-semibold text-slate-900">
              Associate of Science in Engineering
            </p>
            <p class="text-sm text-slate-600">
              Georgia State University · 2013 – 2016
            </p>
          </div>
        </div>
      </section>
    </section>
  </div>
</SiteLayout>
