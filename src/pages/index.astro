---
import SiteLayout from "../layouts/SiteLayout.astro";

const certifications = [
  {
    name: "Microsoft Certified: Azure AI Fundamentals",
    code: "AI-900",
    issuer: "Microsoft",
    earned: "June 2026",
    credentialUrl:
      "https://learn.microsoft.com/en-us/users/ethann-0311/credentials/ab428523e533df1f?ref=https%3A%2F%2Fwww.linkedin.com%2FL",
  },
];
---

<SiteLayout title="Ethan Nguyen | Technical Support & Infrastructure">
  <div class="grid gap-10 lg:grid-cols-[340px_1fr]">
    <!-- Left Column -->
    <aside class="lg:sticky lg:top-10 lg:h-[calc(100vh-5rem)]">
      <div class="space-y-8">
        <!-- Identity -->
        <section>
          <h1 class="text-3xl font-semibold tracking-tight">Ethan Nguyen</h1>
          <p class="mt-1 text-lg text-slate-700">
            Technical Support | Automation | Cloud & Infrastructure
          </p>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            SaaS Troubleshooting • Incident Response • Systems Automation
          </p>
        </section>

        <!-- Contact -->
        <section class="space-y-2">
          <h2
            class="text-sm font-semibold uppercase tracking-wide text-slate-500"
          >
            Contact
          </h2>
          <ul class="space-y-1 text-sm">
            <li>
              <a
                class="underline decoration-slate-300 hover:decoration-slate-600"
                href="mailto:nguyen.ethan@outlook.com"
              >
                Nguyen.Ethan@outlook.com
              </a>
            </li>
            <li>
              <a
                class="underline decoration-slate-300 hover:decoration-slate-600"
                href="https://www.linkedin.com/in/luckynguyen/"
                target="_blank"
                rel="noreferrer"
              >
                LinkedIn
              </a>
            </li>
            <li>
              <a
                class="underline decoration-slate-300 hover:decoration-slate-600"
                href="https://github.com/lucky15987"
                target="_blank"
                rel="noreferrer"
              >
                GitHub
              </a>
            </li>
            <li class="text-slate-600">Atlanta, GA</li>
          </ul>
        </section>

        <!-- Skills -->
        <section class="space-y-2">
          <h2
            class="text-sm font-semibold uppercase tracking-wide text-slate-500"
          >
            Core Skills
          </h2>
          <ul class="space-y-1 text-sm text-slate-700">
            <li>Technical Troubleshooting</li>
            <li>Incident Response</li>
            <li>Systems & Workflow Automation</li>
            <li>Technical Documentation</li>
          </ul>
        </section>

        <!-- Tools -->
        <section class="space-y-2">
          <h2
            class="text-sm font-semibold uppercase tracking-wide text-slate-500"
          >
            Technical Environment
          </h2>
          <div class="flex flex-wrap gap-2">
            {
              [
                "Power BI",
                "Notion",
                "Linear",
                "Slack",
                "SQL",
                "Salesforce",
                "DataDog",
                "Incident.io",
                "REST APIs",
              ].map((tool) => (
                <span class="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-700">
                  {tool}
                </span>
              ))
            }
          </div>
        </section>
      </div>
    </aside>

    <!-- Right Column -->
    <section class="space-y-10">
      <!-- About -->
      <section>
        <h2 class="text-xl font-semibold">About</h2>

        <p class="mt-4 max-w-2xl leading-relaxed text-slate-700">
          I solve technical problems across SaaS platforms, support workflows,
          and self-hosted infrastructure. My professional experience includes
          investigating customer-impacting issues, reproducing defects,
          coordinating incident response, and building automation that improves
          how Support and Engineering work together.
        </p>

        <p class="mt-4 max-w-2xl leading-relaxed text-slate-700">
          Outside of work, I design and maintain a Proxmox-based homelab where I
          work with Linux, Docker, networking, DNS, VPNs, reverse proxies,
          storage, backups, GPU acceleration, and secure remote access. I use
          the environment to build practical systems, troubleshoot failures, and
          strengthen my infrastructure knowledge.
        </p>

        <div class="mt-8 grid gap-8 sm:grid-cols-3">
          <div class="min-w-0">
            <p
              class="text-xs font-semibold uppercase tracking-wide text-slate-500"
            >
              Troubleshooting
            </p>
            <p class="mt-2 text-sm leading-snug text-slate-700">
              Data Logs • Defect Reproduction • Root-Cause Analysis
            </p>
          </div>

          <div class="min-w-0">
            <p
              class="text-xs font-semibold uppercase tracking-wide text-slate-500"
            >
              Systems & Infrastructure
            </p>
            <p class="mt-2 text-sm leading-snug text-slate-700">
              Linux • Windows • Mac • Docker • Virtualization • Networking
            </p>
          </div>

          <div class="min-w-0">
            <p
              class="text-xs font-semibold uppercase tracking-wide text-slate-500"
            >
              Automation &amp; Support
            </p>
            <p class="mt-2 text-sm leading-snug text-slate-700">
              APIs • Dashboards • AI Integrations • Escalation Workflows
            </p>
          </div>
        </div>
      </section>

      <!-- Experience -->
      <section class="space-y-6">
        <h2 class="text-xl font-semibold">Experience</h2>

        <article class="rounded-2xl border border-slate-200 p-6">
          <header
            class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"
          >
            <h3 class="text-base font-semibold">
              Platform Technical Advisor — Liberis
            </h3>
            <p class="text-sm text-slate-600">Jun 2024 – Present</p>
          </header>
          <p class="mt-1 text-sm text-slate-700">Embedded Finance / Fintech</p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-700">
            <li>
              Investigate complex customer issues by analyzing logs, reproducing
              defects, coordinating with Engineering, and communicating
              resolutions to stakeholders.
            </li>

            <li>
              Lead incident response for high-impact platform issues,
              coordinating Support, Engineering, and Product teams and
              contributing to a 20% reduction in resolution time.
            </li>

            <li>
              Designed and implemented an automated engineering escalation
              workflow integrating Freshservice, Slack, Make, and Linear,
              reducing manual effort by approximately 30%.
            </li>

            <li>
              Built structured escalation workflows that improved triage
              consistency and reduced friction between Support and Engineering.
            </li>

            <li>
              Developed operational dashboards using Power BI, Looker, Datadog,
              and Freshservice Analytics to improve visibility into SLA
              performance and escalation trends.
            </li>

            <li>
              Designed an AI-assisted ticket triage workflow to classify,
              summarize, and recommend routing while maintaining human review
              for complex cases.
            </li>
          </ul>
        </article>

        <article class="rounded-2xl border border-slate-200 p-6">
          <header
            class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"
          >
            <h3 class="text-base font-semibold">
              Front-End Developer — Popcapacity
            </h3>
            <p class="text-sm text-slate-600">Aug 2022 – Jun 2024</p>
          </header>
          <p class="mt-1 text-sm text-slate-700">Logistics / Supply Chain</p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-700">
            <li>
              Translated user needs and product ideas into structured user
              stories and implementation-ready requirements, reducing ambiguity
              between product and engineering during development cycles
            </li>

            <li>
              Identified usability and workflow friction points through testing
              and analysis, improving overall product experience and reducing
              user confusion
            </li>

            <li>
              Performed structured QA testing and created reproducible defect
              reports, reducing back-and-forth during releases and improving
              release reliability
            </li>

            <li>
              Collaborated with product managers and designers to validate
              features and UX decisions prior to release, increasing confidence
              in shipped changes
            </li>

            <li>
              Improved front-end consistency by refining component behavior and
              interaction patterns across the platform, reducing inconsistencies
              in user experience
            </li>
          </ul>
        </article>

        <article class="rounded-2xl border border-slate-200 p-6">
          <header
            class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"
          >
            <h3 class="text-base font-semibold">
              Operations Manager — International Real Estate Dream LLC
            </h3>
            <p class="text-sm text-slate-600">Aug 2021 – Aug 2022</p>
          </header>
          <p class="mt-1 text-sm text-slate-700">
            Real Estate / Property Management
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-700">
            <li>
              Led brokerage operations, coordinating workflows across agents and
              stakeholders.
            </li>
            <li>
              Implemented process improvements to increase operational
              efficiency and KPI visibility.
            </li>
            <li>
              Analyzed housing and rental market data to support pricing and
              strategy decisions.
            </li>
            <li>
              Built operational reports and presentations to communicate
              performance trends.
            </li>
          </ul>
        </article>

        <article class="rounded-2xl border border-slate-200 p-6">
          <header
            class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between"
          >
            <h3 class="text-base font-semibold">
              Customer Success Manager — Microsoft
            </h3>
            <p class="text-sm text-slate-600">Apr 2020 – Aug 2021</p>
          </header>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-700">
            <li>
              Led implementation planning for SMB and enterprise clients
              adopting Microsoft cloud solutions.
            </li>
            <li>
              Identified recurring integration challenges and developed
              repeatable enablement approaches.
            </li>
            <li>
              Designed training frameworks for organizations transitioning to
              Microsoft 365.
            </li>
            <li>
              Created reporting templates to surface adoption trends and renewal
              risk signals.
            </li>
          </ul>
        </article>
      </section>

      <!-- Technical Projects -->
      <section class="space-y-4">
        <h2 class="text-xl font-semibold">Technical Projects</h2>

        <div class="grid gap-4 sm:grid-cols-2">
          <a
            class="group rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-sm"
            href="/projects/homelab"
          >
            <h3 class="font-semibold">Personal Infrastructure Homelab</h3>

            <p class="mt-2 text-sm text-slate-700">
              Proxmox-based virtualization environment hosting Linux virtual
              machines, Docker containers, networking services, storage,
              automation, and secure remote access.
            </p>

            <p class="mt-3 text-sm text-slate-600">
              Designed as a production-like learning environment for
              troubleshooting Linux, DNS, networking, virtualization, GPU
              acceleration, service availability, and infrastructure failures.
            </p>

            <ul class="mt-3 text-xs text-slate-600 space-y-1">
              <li>• Virtualized Linux and container workloads</li>
              <li>• Secure VPN and reverse-proxy access</li>
              <li>• Monitoring, backups, storage, and media services</li>
            </ul>

            <p class="mt-4 text-xs text-slate-500 group-hover:text-slate-700">
              View case study →
            </p>
          </a>

          <a
            class="group rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-sm"
            href="/projects/escalation-automation"
          >
            <h3 class="font-semibold">Engineering Escalation Automation</h3>

            <p class="mt-2 text-sm text-slate-700">
              Automated support-to-engineering escalation workflow across
              FreshService, Slack, Make, and Linear.
            </p>

            <p class="mt-3 text-sm text-slate-600">
              Designed a structured pipeline that converted manual handoffs into
              engineering-ready work items with improved visibility and
              traceability.
            </p>

            <ul class="mt-3 text-xs text-slate-600 space-y-1">
              <li>• Reduced manual escalation overhead</li>
              <li>• Standardized engineering-to-work data requirements</li>
              <li>• Improved cross-team visibility</li>
            </ul>

            <p class="mt-4 text-xs text-slate-500 group-hover:text-slate-700">
              View case study →
            </p>
          </a>

          <a
            class="group rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-sm"
            href="/projects/ai-triage"
          >
            <h3 class="font-semibold">AI-Assisted Ticket Triage System</h3>

            <p class="mt-2 text-sm text-slate-700">
              Prototype system using AI to classify, prioritize, and route
              support tickets.
            </p>

            <p class="mt-3 text-sm text-slate-600">
              Designed an AI-assisted workflow to reduce triage time and improve
              routing consistency across support and engineering.
            </p>

            <ul class="mt-3 text-xs text-slate-600 space-y-1">
              <li>• Automated ticket categorization</li>
              <li>• Suggested priority scoring</li>
              <li>• Improved triage consistency</li>
            </ul>

            <p class="mt-4 text-xs text-slate-500 group-hover:text-slate-700">
              View case study →
            </p>
          </a>
        </div>
      </section>

      <!-- Certifications -->
      <section class="space-y-4">
        <div>
          <h2 class="text-xl font-semibold">Certifications</h2>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {
            certifications.map((certification) => (
              <a
                href={certification.credentialUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={`View ${certification.name} credential`}
                class="group rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2"
              >
              
                <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-slate-50 text-sm font-semibold text-slate-700">
                  MS
                </div>

                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                      {certification.issuer}
                    </p>

                    <h3 class="mt-2 font-semibold leading-snug text-slate-900">
                      {certification.name}
                    </h3>

                    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-slate-600">
                      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
                        {certification.code}
                      </span>

                      <span>Earned {certification.earned}</span>
                    </div>
                  </div>

                  <span
                    aria-hidden="true"
                    class="shrink-0 text-lg text-slate-400 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-slate-700"
                  >
                    ↗
                  </span>
                </div>

                <p class="mt-4 text-sm font-medium text-slate-600 transition group-hover:text-slate-900">
                  View credential
                </p>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Education -->
      <section class="space-y-4">
        <h2 class="text-xl font-semibold">Education</h2>

        <div class="space-y-4">
          <div>
            <p class="font-semibold text-slate-900">
              Bachelor of Science in Computer Science
            </p>
            <p class="text-sm text-slate-600">
              Kennesaw State University · 2016 – 2020
            </p>
          </div>

          <div>
            <p class="font-semibold text-slate-900">
              Associate of Science in Engineering
            </p>
            <p class="text-sm text-slate-600">
              Georgia State University · 2013 – 2016
            </p>
          </div>
        </div>
      </section>
    </section>
  </div>
</SiteLayout>
